__pycache__/
*.pyc
.pytest_cache/
node_modules/
build/
dist/
agent/build/
agent/dist/
steam_appid.txt
.claude/
*.png
!icons/*.png

# The server's database is PostgreSQL now and lives in a volume, not a file.
# These patterns remain for the agent's outbox, which is still SQLite and is
# sometimes pointed at the repo during development.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# The agent's outbox lives outside the repo by default (~/.profitdog-agent), but
# not when someone points it here.
outbox.sqlite3*

# The CSV era. Nothing reads these any more — they were imported once, and are
# kept only as an archive of the data before it had a database.
session_*.csv
role_xp_log.csv
*.log

# Local configuration. `.env.example` is the tracked one.
.env
