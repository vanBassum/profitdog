# Copy to .env and fill in. Only the Google client is required for sign-in;
# everything else has a working default for a local run.

# The OAuth client from the Google Cloud console. Its authorized redirect URI
# must be exactly {PROFITDOG_PUBLIC_URL}/auth/callback.
PROFITDOG_GOOGLE_CLIENT_ID=
PROFITDOG_GOOGLE_CLIENT_SECRET=

# Who may create an account: addresses, @domains, or `*` for a public
# instance that admits anyone with a Google account. Empty admits nobody,
# which is the safe way to be wrong on a server facing the internet.
PROFITDOG_ALLOWLIST=

# Where a browser reaches this server. Builds the OAuth redirect and the URL
# the agent sends people to, so it has to be the public address.
PROFITDOG_PUBLIC_URL=http://127.0.0.1:5174

# The account that inherits anything written before there were accounts.
PROFITDOG_OWNER_EMAIL=

# A Secure cookie is never sent back over http, so sign-in would appear to
# work and then silently not. Set to 1 behind TLS.
PROFITDOG_COOKIE_SECURE=0

# Where /download sends people when the server image carries no agent
# build of its own -- the EXE is frozen on a Windows runner and published
# on GitHub. Defaults to this repo's latest release.
PROFITDOG_RELEASES_URL=https://github.com/vanBassum/profitdog/releases/latest

# The database. Compose fills these in for its own postgres service.
POSTGRES_USER=profitdog
POSTGRES_PASSWORD=profitdog
POSTGRES_DB=profitdog
POSTGRES_PORT=55432
PROFITDOG_PORT=5174
